EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional. If set, "Meaning of Today" uses Anthropic claude-haiku-4-5
# to generate a richer, on-device summary. If absent, the app falls
# back to a fully offline, hand-curated summary (no API call).
#
# Dev-only: this direct-key path is only used in development builds
# (__DEV__ === true). In production, the app refuses to call Anthropic
# directly so a bundled key can't leak. For production, set the proxy
# URL below and route the request through a server you control.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Production path for AI "Meaning of Today". Point this at your own
# endpoint that proxies to api.anthropic.com and adds the API key
# server-side. The endpoint must accept {model, max_tokens, messages}
# and return Anthropic-shaped {content: [{type: "text", text}]}.
EXPO_PUBLIC_ANTHROPIC_PROXY_URL=
