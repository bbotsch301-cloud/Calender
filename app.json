{
  "expo": {
    "name": "Kingdom Calendar",
    "slug": "kingdom-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kingdomcalendar.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kingdom Calendar uses your location to compute accurate sunset times for biblical day boundaries and feast observances.",
        "NSFaceIDUsageDescription": "Kingdom Calendar can use Face ID to keep your alignment journey private."
      }
    },
    "android": {
      "package": "com.kingdomcalendar.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#C9A84C"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Kingdom Calendar to use your location for accurate sunset times."
        }
      ],
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
